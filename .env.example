# Lost-Link - Supabase Environment Configuration
# Copy this file to .env.local or set variables in your deployment environment

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous/Public Key (Safe for frontend use - never use service_role here!)
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key

# NOTE: When running locally or in demo preview without active Supabase credentials,
# Lost-Link seamlessly runs with a full client-side simulated persistence layer,
# pre-seeded with realistic campus items, student/admin demo accounts, real-time events,
# and audit trails. Supplying the variables above connects directly to your live Supabase cloud project!
